# Browser entrypoint
OJ_PORT=3000
API_PORT=8000

# Local-only database credentials
POSTGRES_DB=oj
POSTGRES_USER=oj
POSTGRES_PASSWORD=oj-local-password

# Seed three sample problems when the database is empty
SEED_DEMO_DATA=true

# Idempotently import the verified 2009-2025 408 question bank
IMPORT_408_QUESTIONS=true
JUDGE_POLL_INTERVAL=0.8
